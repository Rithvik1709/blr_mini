# Cloudflare Pages. Tile versions are never rewritten (blr.pyramid refuses), so
# they can be cached forever; current.json and search.json can change.
/tiles/*
  Cache-Control: public, max-age=31536000, immutable
/tiles/current.json
  Cache-Control: public, max-age=60
/search.json
  Cache-Control: public, max-age=3600
